{
  "name": "mcn-platform",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:deploy": "pnpm --filter web db:deploy",
    "db:seed": "pnpm --filter web db:seed",
    "db:studio": "pnpm --filter web prisma studio",
    "e2e": "pnpm --filter web e2e",
    "e2e:report": "pnpm --filter web e2e:report",
    "e2e:report:m1": "pnpm e2e && node scripts/generate-test-report.mjs m1",
    "e2e:report:m2": "pnpm e2e && node scripts/generate-test-report.mjs m2",
    "e2e:report:gen": "node scripts/generate-test-report.mjs"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
